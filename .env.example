PORT=3000

# Zona horaria del servidor - importante para que "hoy" y la hora del
# recordatorio coincidan con la hora real de Colombia
TZ=America/Bogota

# Postgres de Neon (Settings -> Connection string en el panel de Neon)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Meta WhatsApp Cloud API (developers.facebook.com -> tu app -> WhatsApp -> Configuracion de la API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cadena que tu inventas y pones tambien en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-este-valor
# Nombre y lenguaje de la plantilla aprobada usada para los recordatorios automaticos
WHATSAPP_TEMPLATE_NAME=recordatorio_pagos
WHATSAPP_TEMPLATE_LANG=es

# Google AI Studio (aistudio.google.com/apikey) - capa gratuita
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Secreto para proteger /api/cron/revisar (usado por un cron externo en Render, ver README)
CRON_SECRET=cambia-este-valor

# Clave para firmar las sesiones de login (web + app movil). Genera una propia con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-valor

# Notificaciones push a la app movil (Firebase). En Render se sube el JSON de
# la cuenta de servicio como "Secret File" en /etc/secrets/firebase-service-account.json
# (esa ruta es el valor por defecto, no hace falta declarar esta variable en Render).
# En local, guarda el mismo archivo en la raiz del proyecto como firebase-service-account.json.
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
